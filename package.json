{
  "name": "basedland",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 browser MMO prototype with chunked binary networking.",
  "scripts": {
    "build": "node esbuild.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:buildings": "node scripts/generate-assets.mjs --only-objects house,pub,inn,barn,stable,blacksmith,windmill,chapel,market,manor,townhall --replace-objects house,pub,inn,barn,stable,blacksmith,windmill,chapel,market,manor,townhall --house-target 20 --building-target 3",
    "assets:terrain": "node scripts/generate-bridge-terrain-tiles.mjs",
    "assets:stamps": "node scripts/generate-landmark-stamps.mjs",
    "assets:intro": "node scripts/generate-intro-parchment.mjs && node scripts/generate-intro-seal.mjs",
    "assets:stable-ui": "node scripts/generate-stable-horse-previews.mjs",
    "assets:import-local": "node scripts/import-local-assets.mjs",
    "outfits:generate": "node scripts/generate-player-outfit-boards.mjs",
    "player:generate": "node scripts/generate-player-sprites.mjs",
    "world:generate": "node scripts/generate-world-layout.mjs",
    "start": "node dist/server/server.js",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "ethers": "^6.16.0",
    "openai": "^6.4.0",
    "sharp": "^0.34.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0"
  }
}
